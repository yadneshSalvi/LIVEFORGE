    "source": "export default {\n  version: 1,\n  name: \"Still Shadows\",\n  description: \"Leave a crate still for half a second and its shadow from a nearby lit lantern becomes a solid bridge. Move the crate to remove the bridge.\",\n  rules: [\n    {\n      id: \"still-prop-shadow-bridge\",\n      each: \"prop\",\n      on: \"tick\",\n      when: {\n        compare: {\n          left: { field: \"stationaryTicks\" },\n          op: \"gte\",\n          right: 30\n        }\n      },\n      actions: [\n        {\n          type: \"projectShadow\",\n          maxLength: 320,\n          thickness: 10,\n          lifetime: 1,\n          solid: true\n        }\n      ]\n    }\n  ]\n} satisfies RuleModule;",

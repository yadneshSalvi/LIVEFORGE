    "source": "export default {\n  version: 1,\n  name: \"Running jumps\",\n  description: \"The faster you run, the stronger your next jump becomes, up to 60% stronger than a standing jump.\",\n  rules: [\n    {\n      id: \"speed-strengthens-jumps\",\n      each: \"player\",\n      on: \"tick\",\n      when: { compare: { left: 1, op: \"eq\", right: 1 } },\n      actions: [\n        {\n          type: \"physics\",\n          target: \"self\",\n          jumpStrength: {\n            clamp: {\n              value: { add: [1, { mul: [{ field: \"speed\" }, 0.05] }] },\n              min: 1,\n              max: 1.6\n            }\n          }\n        }\n      ]\n    }\n  ]\n} satisfies RuleModule;",

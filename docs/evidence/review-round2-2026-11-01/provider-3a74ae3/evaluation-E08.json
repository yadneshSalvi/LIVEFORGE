    "source": "export default {\n  version: 1,\n  name: \"Running Builds Your Jump\",\n  description: \"The faster you run, the higher your next jump rises, up to 60% more jump strength.\",\n  rules: [\n    {\n      id: \"running-strengthens-jumps\",\n      each: \"player\",\n      on: \"tick\",\n      when: { compare: { left: 1, op: \"eq\", right: 1 } },\n      actions: [\n        {\n          type: \"physics\",\n          target: \"self\",\n          jumpStrength: {\n            clamp: {\n              value: {\n                add: [\n                  1,\n                  {\n                    mul: [\n                      0.08,\n                      { max: [{ field: \"vx\" }, { mul: [-1, { field: \"vx\" }] }] }\n                    ]\n                  }\n                ]\n              },\n              min: 1,\n              max: 1.6\n            }\n          },\n          lifetime: 1\n        }\n      ]\n    }\n  ]\n} satisfies RuleModule;",

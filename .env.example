# Values below are placeholders. Keep real values in ignored .env.local or Vercel.
# npm run setup creates local session/encryption secrets without printing them.
APP_BASE_URL=http://localhost:3100
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Required in production. Optional locally (durable .local/store fallback).
DATABASE_URL=

# Fresh runtime generation. Public/local reused examples need no model key.
OPENAI_API_KEY=
CODEX_MODEL=gpt-6.1-sol
# Comma-separated invited Twitch host IDs; required for hosted fresh generation.
LIVEFORGE_GENERATION_HOST_IDS=

# Sandbox auth: automatic OIDC on Vercel; fresh linked-project OIDC locally.
VERCEL_OIDC_TOKEN=
# Alternative local Sandbox identity: all three are required together.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Twitch app: register ${APP_BASE_URL}/api/auth/twitch/callback exactly.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# The app derives its callback from APP_BASE_URL; copied redirect is not used.
TWITCH_REDIRECT_URI=
TWITCH_SCOPES=user:read:chat

# Optional development-only bootstrap. Never reused by deployed visitors.
# Refresh ownership stays with the setup owner, never the application.
TWITCH_USER_ACCESS_TOKEN=
TWITCH_USER_REFRESH_TOKEN=
TWITCH_USER_ID=
TWITCH_BROADCASTER_ID=
TWITCH_CHANNEL_LOGIN=
TWITCH_TOKEN_EXPIRES_AT=
